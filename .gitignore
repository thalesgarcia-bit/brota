# build
/.next/
/out/
/build
next-env.d.ts.timestamp
*.tsbuildinfo

# saida do build para Cloudflare — o OpenNext copia o projeto inteiro
# (inclusive a pasta .git) para dentro de .open-next. Versionar isso faz o
# Git registrar um submodulo fantasma e quebra o clone no Cloudflare.
/.open-next/
/.wrangler/

# ambiente — NUNCA versionar segredos
.env
.env.local
.env.*.local

# uploads locais (armazenamento de desenvolvimento)
/public/uploads/*
!/public/uploads/.gitkeep

# testes
/coverage
/test-results
/playwright-report
/blob-report
/playwright/.cache

# sistema
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.vscode/*
!.vscode/extensions.json
.idea

