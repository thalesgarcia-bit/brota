# =============================================================================
# BROTA — variáveis de ambiente
# Copie este arquivo para `.env.local` e preencha os valores.
# NUNCA versione o `.env.local`.
# =============================================================================

# --- Banco de dados ----------------------------------------------------------
# São DUAS conexões para o mesmo banco, e a diferença importa:
#
#   DATABASE_URL  porta 6543, passa pelo pooler. É o que a aplicação usa.
#   DIRECT_URL    porta 5432, conexão direta. Só o Prisma CLI usa, para criar
#                 as migrations — o pooler não suporta esses comandos.
#
# No Supabase: Project Settings > Database > Connection string.
DATABASE_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres.SEUPROJETO:SENHA@aws-1-sa-east-1.pooler.supabase.com:5432/postgres"

# Postgres local via Docker (docker compose up -d): as duas apontam para o mesmo lugar.
# DATABASE_URL="postgresql://brota:brota@localhost:5432/brota?schema=public"
# DIRECT_URL="postgresql://brota:brota@localhost:5432/brota?schema=public"

# --- Autenticação (Auth.js) --------------------------------------------------
# Gere um segredo com:  npx auth secret     (ou)  openssl rand -base64 32
AUTH_SECRET="troque-este-valor-por-um-segredo-aleatorio"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# --- Aplicação ---------------------------------------------------------------
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Identificação de plantas por imagem -------------------------------------
# Provedor ativo: "plantnet" | "none"
# Com "none" a funcionalidade fica visivelmente indisponível — nunca simulada.
PLANT_ID_PROVIDER="plantnet"
# Chave gratuita para uso educacional: https://my.plantnet.org  (menu "Configurações")
PLANTNET_API_KEY=""
# Projeto/flora consultada. "all" cobre a flora mundial; "weurope", "canada" etc.
PLANTNET_PROJECT="all"
# Abaixo deste percentual de confiança a identificação vai para a fila do administrador.
PLANT_ID_CONFIDENCE_THRESHOLD="0.35"
# Mock do provedor — SOMENTE em desenvolvimento. Ignorado quando NODE_ENV=production.
PLANT_ID_ALLOW_MOCK="false"

# --- Mapa / Onde comprar -----------------------------------------------------
# Provedor ativo: "osm" (OpenStreetMap, sem chave) | "none"
PLACES_PROVIDER="osm"
# Endpoints públicos. Troque por uma instância própria em produção com volume.
OVERPASS_API_URL="https://overpass-api.de/api/interpreter"
NOMINATIM_API_URL="https://nominatim.openstreetmap.org"
# Exigido pela política de uso do Nominatim: identifique sua aplicação e contato.
OSM_USER_AGENT="BROTA/0.1 (contato@exemplo.org)"

# --- Armazenamento de imagens ------------------------------------------------
# "local"    grava em /public/uploads — só funciona na sua máquina.
# "supabase" guarda no Supabase Storage — é o que o site publicado usa,
#            porque o disco do servidor é apagado a cada atualização.
STORAGE_PROVIDER="local"
STORAGE_LOCAL_DIR="./public/uploads"
STORAGE_PUBLIC_PREFIX="/uploads"
MAX_UPLOAD_MB="8"

# Painel do Supabase > Project Settings > API
SUPABASE_URL=""
# A chave "service_role" ignora as políticas de acesso: NUNCA no navegador,
# nunca no Git. Só aqui e nas variáveis do servidor.
SUPABASE_SERVICE_ROLE_KEY=""
# Nome do bucket criado em Storage. Precisa estar marcado como público.
SUPABASE_STORAGE_BUCKET="brota"

# --- Conta administrativa inicial (usada apenas pelo seed) -------------------
SEED_ADMIN_EMAIL="admin@brota.local"
SEED_ADMIN_PASSWORD="brota-admin-2026"
